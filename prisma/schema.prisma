generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String?
  passwordHash        String?
  activationToken     String?         @unique
  activationExpiresAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  memberships CompanyMember[]
  sessions    Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id                  String           @id @default(cuid())
  name                String
  tradeName           String?
  responsibleName     String?
  email               String?
  phone               String?
  whatsapp            String?
  website             String?
  instagram           String?
  logoUrl             String?
  address             String?
  addressNumber       String?
  addressComplement   String?
  neighborhood        String?
  city                String?
  state               String?
  zipCode             String?
  defaultPaymentTerms String?
  defaultDeadline     String?
  defaultValidityDays Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  members         CompanyMember[]
  customers       Customer[]
  followUps       FollowUp[]
  pricingProfiles PricingProfile[]
  quotes          Quote[]
  services        Service[]

  @@index([name])
}

model CompanyMember {
  id        String      @id @default(cuid())
  companyId String
  userId    String
  role      CompanyRole @default(MEMBER)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  whatsapp  String?
  document  String?
  address   String?
  city      String?
  state     String?
  zipCode   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  followUps FollowUp[]
  quotes    Quote[]

  @@index([companyId])
  @@index([companyId, name])
}

model Service {
  id              String        @id @default(cuid())
  companyId       String
  name            String
  description     String?
  baseHourlyRate  Decimal?      @db.Decimal(12, 2)
  defaultQuantity Decimal       @default(1) @db.Decimal(12, 2)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  quoteItems QuoteItem[]
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costs     ServiceCost[]

  @@index([companyId])
  @@index([companyId, active])
}

model ServiceCost {
  id        String  @id @default(cuid())
  serviceId String
  name      String
  amount    Decimal @db.Decimal(12, 2)
  active    Boolean @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model PricingProfile {
  id                  String        @id @default(cuid())
  companyId           String
  name                String
  desiredMargin       Decimal       @db.Decimal(5, 2)
  defaultHourlyRate   Decimal?      @db.Decimal(12, 2)
  defaultTaxRate      Decimal       @default(0) @db.Decimal(5, 2)
  defaultDiscountType DiscountType?
  defaultDiscount     Decimal?      @db.Decimal(12, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Quote {
  id                 String               @id @default(cuid())
  companyId          String
  customerId         String
  number             String
  status             QuoteStatus          @default(DRAFT)
  title              String
  description        String?
  subtotal           Decimal              @db.Decimal(12, 2)
  discountType       DiscountType?
  discountValue      Decimal?             @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(12, 2)
  surchargeType      SurchargeType?
  surchargeValue     Decimal?             @db.Decimal(12, 2)
  surchargeAmount    Decimal              @default(0) @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  paymentTerms       String?
  deadline           String?
  validUntil         DateTime?
  notes              String?
  publicToken        String?              @unique
  publicPublishedAt  DateTime?
  publicViewedAt     DateTime?
  pricingSnapshot    Json?
  commercialSnapshot Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  followUps     FollowUp[]
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id])
  items         QuoteItem[]
  statusHistory QuoteStatusHistory[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([customerId])
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  serviceId       String?
  description     String
  quantity        Decimal  @db.Decimal(12, 2)
  unitPrice       Decimal  @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  pricingSnapshot Json?

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([quoteId])
  @@index([serviceId])
}

model QuoteStatusHistory {
  id         String       @id @default(cuid())
  quoteId    String
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  createdAt  DateTime     @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
}

model FollowUp {
  id               String         @id @default(cuid())
  companyId        String
  customerId       String
  quoteId          String?
  dueAt            DateTime
  status           FollowUpStatus @default(PENDING)
  suggestedMessage String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  quote    Quote?   @relation(fields: [quoteId], references: [id])

  @@index([companyId, status, dueAt])
  @@index([customerId])
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum SurchargeType {
  FIXED
  PERCENTAGE
}