generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum CompanyRole { OWNER ADMIN MEMBER }
enum QuoteStatus { DRAFT SENT VIEWED ACCEPTED REJECTED EXPIRED CANCELLED }
enum FollowUpStatus { PENDING COMPLETED CANCELLED }
model User { id String @id @default(cuid()); email String @unique; name String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; memberships CompanyMember[] }
model Company { id String @id @default(cuid()); name String; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; members CompanyMember[]; customers Customer[]; services Service[]; pricingProfiles PricingProfile[]; quotes Quote[]; followUps FollowUp[] }
model CompanyMember { id String @id @default(cuid()); companyId String; userId String; role CompanyRole @default(MEMBER); company Company @relation(fields:[companyId],references:[id],onDelete:Cascade); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([companyId,userId]); @@index([userId]) }
model Customer { id String @id @default(cuid()); companyId String; name String; email String?; phone String?; notes String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; company Company @relation(fields:[companyId],references:[id],onDelete:Cascade); quotes Quote[]; followUps FollowUp[]; @@index([companyId]) }
model Service { id String @id @default(cuid()); companyId String; name String; description String?; baseHourlyRate Decimal? @db.Decimal(12,2); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; company Company @relation(fields:[companyId],references:[id],onDelete:Cascade); costs ServiceCost[]; quoteItems QuoteItem[]; @@index([companyId]) }
model ServiceCost { id String @id @default(cuid()); serviceId String; name String; amount Decimal @db.Decimal(12,2); service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade); @@index([serviceId]) }
model PricingProfile { id String @id @default(cuid()); companyId String; name String; desiredMargin Decimal @db.Decimal(5,2); defaultHourlyRate Decimal? @db.Decimal(12,2); company Company @relation(fields:[companyId],references:[id],onDelete:Cascade); @@index([companyId]) }
model Quote { id String @id @default(cuid()); companyId String; customerId String; number String; status QuoteStatus @default(DRAFT); title String; description String?; subtotal Decimal @db.Decimal(12,2); total Decimal @db.Decimal(12,2); paymentTerms String?; deadline String?; validUntil DateTime?; publicToken String? @unique; snapshot Json?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; company Company @relation(fields:[companyId],references:[id],onDelete:Cascade); customer Customer @relation(fields:[customerId],references:[id]); items QuoteItem[]; statusHistory QuoteStatusHistory[]; followUps FollowUp[]; @@unique([companyId,number]); @@index([companyId,status]) }
model QuoteItem { id String @id @default(cuid()); quoteId String; serviceId String?; description String; quantity Decimal @db.Decimal(12,2); unitPrice Decimal @db.Decimal(12,2); total Decimal @db.Decimal(12,2); quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade); service Service? @relation(fields:[serviceId],references:[id],onDelete:SetNull); @@index([quoteId]) }
model QuoteStatusHistory { id String @id @default(cuid()); quoteId String; fromStatus QuoteStatus?; toStatus QuoteStatus; createdAt DateTime @default(now()); quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade); @@index([quoteId,createdAt]) }
model FollowUp { id String @id @default(cuid()); companyId String; customerId String; quoteId String?; dueAt DateTime; status FollowUpStatus @default(PENDING); suggestedMessage String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; company Company @relation(fields:[companyId],references:[id],onDelete:Cascade); customer Customer @relation(fields:[customerId],references:[id]); quote Quote? @relation(fields:[quoteId],references:[id],onDelete:SetNull); @@index([companyId,status,dueAt]) }